# =============================================================================
# Cel i Animació — variables de entorno (copia este archivo a .env.local)
# -----------------------------------------------------------------------------
# Son los valores PÚBLICOS de la app web de Firebase (Consola > Configuración del
# proyecto > Tus apps > SDK de Firebase). No son secretos: se incluyen en el
# JavaScript que descarga cualquier navegador. La seguridad depende de
# Firebase Authentication + firestore.rules.
#
# NUNCA pongas aquí (ni en ninguna variable NEXT_PUBLIC_*) claves privadas,
# cuentas de servicio del Admin SDK ni tokens.
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# "true" para usar los emuladores locales (Auth :9099, Firestore :8080)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
