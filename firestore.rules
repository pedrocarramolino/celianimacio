rules_version = '2';

// =============================================================================
//  CEL I ANIMACIÓ — Reglas de seguridad de Cloud Firestore (plan Spark)
// -----------------------------------------------------------------------------
//  Principios:
//   * Denegar por defecto: cualquier ruta no declarada queda bloqueada.
//   * El rol NUNCA se acepta desde el cliente: un usuario solo puede crear su
//     perfil con rol "worker" y únicamente si existe una invitación pendiente
//     para su email verificado.
//   * Rol efectivo = custom claim "role" (si en el futuro se establece con el
//     Admin SDK) o, en su defecto, users/{uid}.role.
//   * Los trabajadores solo leen lo suyo; los nombres de compañeros se exponen
//     mediante shiftTeams (solo turnos confirmados y compartidos).
//   * Los fichajes son de solo inserción para el trabajador: no puede editar
//     una entrada ya registrada ni reabrir una jornada cerrada.
//   * Las horas de servidor se fuerzan con request.time (serverTimestamp()).
//
//  LIMITACIÓN (sin backend): las coordenadas GPS y la distancia las calcula el
//  navegador. Las reglas validan la estructura y la secuencia, NO la
//  autenticidad de la ubicación.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function docPath(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }
    function userPath() { return docPath('users', uid()); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function claimRole() { return request.auth.token.get('role', null); }

    function isAdmin() {
      return signedIn() && (
        claimRole() == 'admin' ||
        (hasProfile() && profile().role == 'admin' && profile().active == true)
      );
    }
    function isWorker() {
      return hasProfile() && profile().role == 'worker' && profile().active == true;
    }
    // Empleado vinculado al usuario actual (puede ser null para administradores).
    function myEmployeeId() { return profile().get('employeeId', null); }
    function hasEmployee() { return hasProfile() && profile().active == true && myEmployeeId() is string; }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) is string;
    }
    function myEmailLower() { return request.auth.token.email.lower(); }

    function data() { return request.resource.data; }
    function prev() { return resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function isStr(v, minLen, maxLen) { return v is string && v.size() >= minLen && v.size() <= maxLen; }
    function isStrOrNull(v, maxLen) { return v == null || isStr(v, 0, maxLen); }
    function isISODate(v) { return v is string && v.matches('^[0-9]{4}-[0-1][0-9]-[0-3][0-9]$'); }
    function isClock(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function isEmail(v) { return v is string && v.size() <= 254 && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'); }
    function isLat(v) { return v is number && v >= -90 && v <= 90; }
    function isLng(v) { return v is number && v >= -180 && v <= 180; }
    function isNumOrNull(v) { return v == null || v is number; }
    function isStrList(v, maxSize) { return v is list && v.size() <= maxSize; }

    function createdNow() { return data().createdAt == request.time && data().updatedAt == request.time; }
    function updatedNow() { return data().updatedAt == request.time; }
    function keepsCreation() {
      return data().createdAt == prev().createdAt && data().createdBy == prev().createdBy;
    }

    function validLocationSnapshot(l) {
      return l is map
        && l.keys().hasOnly(['locationId', 'name', 'address', 'lat', 'lng', 'radiusMeters'])
        && l.keys().hasAll(['locationId', 'name', 'address', 'lat', 'lng', 'radiusMeters'])
        && isStrOrNull(l.locationId, 128)
        && isStr(l.name, 1, 160)
        && isStr(l.address, 0, 300)
        && isLat(l.lat) && isLng(l.lng)
        && l.radiusMeters is number && l.radiusMeters >= 10 && l.radiusMeters <= 5000;
    }

    // ===================================================================== users
    // users/{uid}: perfil de acceso y rol.
    match /users/{userId} {
      function userKeys() {
        return ['email', 'displayName', 'role', 'employeeId', 'active', 'createdAt', 'updatedAt', 'createdBy'];
      }
      function validUser() {
        return data().keys().hasOnly(userKeys()) && data().keys().hasAll(userKeys())
          && isEmail(data().email)
          && isStr(data().displayName, 1, 120)
          && data().role in ['admin', 'worker']
          && (data().employeeId == null || isStr(data().employeeId, 1, 128))
          && data().active is bool;
      }
      function invitation() { return get(docPath('invitations', myEmailLower())).data; }

      allow read: if isAdmin() || (signedIn() && uid() == userId);

      // Activación de un trabajador invitado: el propio usuario crea su perfil
      // con rol "worker" y la ficha indicada en su invitación pendiente.
      allow create: if signedIn() && uid() == userId
        && verifiedEmail()
        && validUser()
        && createdNow()
        && data().createdBy == uid()
        && data().role == 'worker'
        && data().active == true
        && data().email.lower() == myEmailLower()
        && invitation().status == 'pending'
        && invitation().employeeId == data().employeeId;

      // Un administrador puede gestionar perfiles existentes (rol, estado, ficha).
      allow update: if isAdmin() && validUser() && updatedNow() && keepsCreation()
        && data().email == prev().email;

      // El propio usuario solo puede cambiar su nombre visible. Nunca su rol.
      allow update: if signedIn() && uid() == userId && validUser() && updatedNow()
        && changedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;
    }

    // ================================================================= employees
    // employees/{employeeId}: ficha laboral con datos privados.
    match /employees/{employeeId} {
      function employeeKeys() {
        return ['firstName', 'lastName', 'email', 'emailLower', 'phone', 'position', 'hireDate',
                'status', 'photoURL', 'userId', 'notes', 'createdAt', 'updatedAt', 'createdBy'];
      }
      function validEmployee() {
        return data().keys().hasOnly(employeeKeys()) && data().keys().hasAll(employeeKeys())
          && isStr(data().firstName, 1, 80)
          && isStr(data().lastName, 0, 120)
          && isEmail(data().email)
          && data().emailLower == data().email.lower()
          && isStr(data().phone, 0, 30)
          && isStr(data().position, 0, 80)
          && (data().hireDate == null || isISODate(data().hireDate))
          && data().status in ['active', 'inactive']
          && (data().photoURL == null || (isStr(data().photoURL, 8, 1000) && data().photoURL.matches('^https://.*')))
          && (data().userId == null || isStr(data().userId, 1, 128))
          && isStr(data().notes, 0, 2000);
      }

      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());

      allow create: if isAdmin() && validEmployee() && createdNow() && data().createdBy == uid()
        && data().userId == null;
      allow update: if isAdmin() && validEmployee() && updatedNow() && keepsCreation();

      // Vinculación durante la activación (mismo lote que users/{uid}).
      allow update: if verifiedEmail()
        && prev().userId == null
        && prev().emailLower == myEmailLower()
        && changedKeys().hasOnly(['userId', 'updatedAt'])
        && data().userId == uid()
        && updatedNow()
        && get(docPath('invitations', myEmailLower())).data.employeeId == employeeId
        && get(docPath('invitations', myEmailLower())).data.status == 'pending';

      // El trabajador puede actualizar su teléfono de contacto.
      allow update: if signedIn() && prev().userId == uid()
        && changedKeys().hasOnly(['phone', 'updatedAt'])
        && isStr(data().phone, 0, 30) && updatedNow();

      allow delete: if false;
    }

    // =============================================================== invitations
    // invitations/{emailLower}: autoriza a un email verificado a activar su cuenta.
    match /invitations/{email} {
      function invitationKeys() {
        return ['email', 'employeeId', 'displayName', 'role', 'status', 'createdAt', 'createdBy',
                'acceptedBy', 'acceptedAt'];
      }
      function validInvitation() {
        return data().keys().hasOnly(invitationKeys()) && data().keys().hasAll(invitationKeys())
          && isEmail(data().email) && data().email.lower() == email
          && isStr(data().employeeId, 1, 128)
          && isStr(data().displayName, 1, 200)
          && data().role == 'worker'
          && data().status in ['pending', 'accepted', 'revoked'];
      }

      allow read: if isAdmin() || (verifiedEmail() && myEmailLower() == email);

      allow create: if isAdmin() && validInvitation() && data().status == 'pending'
        && data().createdAt == request.time && data().createdBy == uid()
        && data().acceptedBy == null && data().acceptedAt == null
        && existsAfter(docPath('employees', data().employeeId));
      allow update: if isAdmin() && validInvitation();

      // Aceptación por el propio trabajador (mismo lote en que crea su perfil).
      allow update: if verifiedEmail() && myEmailLower() == email
        && prev().status == 'pending'
        && changedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && data().status == 'accepted'
        && data().acceptedBy == uid()
        && data().acceptedAt == request.time
        && existsAfter(docPath('users', uid()));

      allow delete: if isAdmin();
    }

    // ================================================================= locations
    match /locations/{locationId} {
      function locationKeys() {
        return ['name', 'address', 'lat', 'lng', 'radiusMeters', 'notes', 'createdAt', 'updatedAt', 'createdBy'];
      }
      function validLocation() {
        return data().keys().hasOnly(locationKeys()) && data().keys().hasAll(locationKeys())
          && isStr(data().name, 1, 160) && isStr(data().address, 0, 300)
          && isLat(data().lat) && isLng(data().lng)
          && data().radiusMeters is number && data().radiusMeters >= 10 && data().radiusMeters <= 5000
          && isStr(data().notes, 0, 1000);
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && validLocation() && createdNow() && data().createdBy == uid();
      allow update: if isAdmin() && validLocation() && updatedNow() && keepsCreation();
      allow delete: if isAdmin();
    }

    // ==================================================================== events
    match /events/{eventId} {
      function eventKeys() {
        return ['name', 'description', 'date', 'location', 'instructions', 'status', 'staffEmployeeIds',
                'shiftCount', 'createdAt', 'updatedAt', 'createdBy'];
      }
      // Campos opcionales (añadidos después): no invalidan eventos antiguos.
      function optionalEventKeys() {
        return ['category', 'meetingTime', 'meetingPlace', 'startTime', 'endTime', 'room', 'kids', 'ages',
                'dressCode', 'material', 'contactPhone', 'totalPrice', 'paidAmount', 'extraHour'];
      }
      function validSheet(d) {
        return (d.get('meetingTime', '') == '' || isClock(d.meetingTime))
          && (d.get('startTime', '') == '' || isClock(d.startTime))
          && (d.get('endTime', '') == '' || isClock(d.endTime))
          && d.get('meetingPlace', '') is string && d.get('meetingPlace', '').size() <= 120
          && d.get('room', '') is string && d.get('room', '').size() <= 120
          && d.get('ages', '') is string && d.get('ages', '').size() <= 80
          && d.get('dressCode', '') is string && d.get('dressCode', '').size() <= 200
          && d.get('material', '') is string && d.get('material', '').size() <= 2000
          && d.get('contactPhone', '') is string && d.get('contactPhone', '').size() <= 30
          && d.get('extraHour', '') is string && d.get('extraHour', '').size() <= 120
          && (d.get('kids', null) == null || (d.kids is int && d.kids >= 0 && d.kids <= 2000))
          && (d.get('totalPrice', null) == null || (d.totalPrice is number && d.totalPrice >= 0))
          && (d.get('paidAmount', null) == null || (d.paidAmount is number && d.paidAmount >= 0));
      }
      function validEvent() {
        return data().keys().hasOnly(eventKeys().concat(optionalEventKeys())) && data().keys().hasAll(eventKeys())
          && validSheet(data())
          && (!('category' in data()) || data().category in ['boda', 'comunion', 'bautizo', 'cumpleanos',
              'fiesta_infantil', 'papa_noel', 'halloween', 'fallas', 'fiesta_espuma', 'campus', 'torneo',
              'empresa', 'otro'])
          && isStr(data().name, 1, 160)
          && isStr(data().description, 0, 4000)
          && isISODate(data().date)
          && validLocationSnapshot(data().location)
          && isStr(data().instructions, 0, 4000)
          && data().status in ['draft', 'scheduled', 'in_progress', 'completed', 'cancelled']
          && isStrList(data().staffEmployeeIds, 500)
          && data().shiftCount is int && data().shiftCount >= 0;
      }

      allow read: if isAdmin()
        || (isWorker() && myEmployeeId() in resource.data.staffEmployeeIds);
      allow create: if isAdmin() && validEvent() && createdNow() && data().createdBy == uid();
      allow update: if isAdmin() && validEvent() && updatedNow() && keepsCreation();
      allow delete: if false; // los eventos se cancelan, no se borran
    }

    // ================================================================ eventPrivate
    // Notas internas del evento: solo administración.
    match /eventPrivate/{eventId} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && data().keys().hasOnly(['adminNotes', 'updatedAt'])
        && isStr(data().adminNotes, 0, 2000)
        && updatedNow();
    }

    // ==================================================================== shifts
    match /shifts/{shiftId} {
      function shiftKeys() {
        return ['eventId', 'eventName', 'name', 'date', 'startAt', 'endAt', 'requiredWorkers', 'position',
                'location', 'instructions', 'status', 'staffEmployeeIds', 'confirmedEmployeeIds',
                'createdAt', 'updatedAt', 'createdBy'];
      }
      function validShift() {
        return data().keys().hasOnly(shiftKeys()) && data().keys().hasAll(shiftKeys())
          && isStr(data().eventId, 1, 128)
          && isStr(data().eventName, 1, 160)
          && isStr(data().name, 1, 120)
          && isISODate(data().date)
          && data().startAt is timestamp && data().endAt is timestamp
          && data().endAt > data().startAt
          && data().endAt < data().startAt + duration.value(24, 'h')
          && data().requiredWorkers is int && data().requiredWorkers >= 1 && data().requiredWorkers <= 200
          && isStr(data().position, 0, 80)
          && (data().location == null || validLocationSnapshot(data().location))
          && isStr(data().instructions, 0, 4000)
          && data().status in ['open', 'partially_filled', 'filled', 'cancelled']
          && isStrList(data().staffEmployeeIds, 200)
          && isStrList(data().confirmedEmployeeIds, 200);
      }

      allow read: if isAdmin()
        || (isWorker() && myEmployeeId() in resource.data.staffEmployeeIds);
      allow create: if isAdmin() && validShift() && createdNow() && data().createdBy == uid()
        && exists(docPath('events', data().eventId));
      allow update: if isAdmin() && validShift() && updatedNow() && keepsCreation()
        && data().eventId == prev().eventId;
      allow delete: if false; // los turnos se cancelan
    }

    // =========================================================== shiftTeams
    // Nombres de compañeros confirmados. Sin datos privados.
    match /shiftTeams/{shiftId} {
      function validTeam() {
        return data().keys().hasOnly(['shiftId', 'eventId', 'memberEmployeeIds', 'members', 'updatedAt'])
          && data().shiftId == shiftId
          && isStr(data().eventId, 1, 128)
          && isStrList(data().memberEmployeeIds, 200)
          && data().members is list && data().members.size() == data().memberEmployeeIds.size()
          && updatedNow();
      }
      allow read: if isAdmin()
        || (isWorker() && myEmployeeId() in resource.data.memberEmployeeIds);
      allow create, update: if isAdmin() && validTeam();
      allow delete: if false;
    }

    // ============================================================== availability
    // availability/{employeeId}_{weekStart}
    match /availability/{availabilityId} {
      function validSlots(s) {
        return s is list && s.size() <= 6;
      }
      function validDay(d) {
        return d is map
          && d.keys().hasOnly(['date', 'status', 'slots'])
          && isISODate(d.date)
          && d.status in ['unset', 'available', 'partial', 'unavailable']
          && validSlots(d.slots)
          && (d.status == 'partial' || d.slots.size() == 0);
      }
      function validAvailability() {
        return data().keys().hasOnly(['employeeId', 'weekStart', 'days', 'note', 'updatedAt', 'updatedBy'])
          && data().keys().hasAll(['employeeId', 'weekStart', 'days', 'note', 'updatedAt', 'updatedBy'])
          && isStr(data().employeeId, 1, 128)
          && isISODate(data().weekStart)
          && availabilityId == data().employeeId + '_' + data().weekStart
          && data().days is list && data().days.size() == 7
          && validDay(data().days[0]) && validDay(data().days[1]) && validDay(data().days[2])
          && validDay(data().days[3]) && validDay(data().days[4]) && validDay(data().days[5])
          && validDay(data().days[6])
          && data().days[0].date == data().weekStart
          && isStr(data().note, 0, 1000)
          && data().updatedBy == uid()
          && updatedNow();
      }
      function ownsIncoming() { return hasEmployee() && data().employeeId == myEmployeeId(); }

      // Lectura por id (permite consultar una semana aún no guardada) o por consulta filtrada.
      allow get: if isAdmin()
        || (hasEmployee() && availabilityId.matches('^' + myEmployeeId() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      allow list: if isAdmin() || (hasEmployee() && resource.data.employeeId == myEmployeeId());
      allow create: if validAvailability() && (isAdmin() || ownsIncoming());
      allow update: if validAvailability() && data().employeeId == prev().employeeId
        && (isAdmin() || ownsIncoming());
      allow delete: if isAdmin();
    }

    // =============================================================== assignments
    // assignments/{shiftId}_{employeeId}: solo los administradores asignan.
    match /assignments/{assignmentId} {
      function assignmentKeys() {
        return ['shiftId', 'eventId', 'employeeId', 'employeeName', 'eventName', 'shiftName', 'shiftStartAt',
                'shiftEndAt', 'status', 'cancelledReason', 'createdAt', 'updatedAt', 'createdBy'];
      }
      function validAssignment() {
        return data().keys().hasOnly(assignmentKeys()) && data().keys().hasAll(assignmentKeys())
          && assignmentId == data().shiftId + '_' + data().employeeId
          && isStr(data().eventId, 1, 128)
          && isStr(data().employeeName, 1, 200)
          && isStr(data().eventName, 1, 160)
          && isStr(data().shiftName, 1, 120)
          && data().shiftStartAt is timestamp && data().shiftEndAt is timestamp
          && data().status in ['pending', 'confirmed', 'cancelled']
          && isStr(data().cancelledReason, 0, 500);
      }

      allow read: if isAdmin() || (hasEmployee() && resource.data.employeeId == myEmployeeId());
      allow create: if isAdmin() && validAssignment() && createdNow() && data().createdBy == uid()
        && exists(docPath('shifts', data().shiftId))
        && exists(docPath('employees', data().employeeId));
      allow update: if isAdmin() && validAssignment() && updatedNow() && keepsCreation()
        && data().shiftId == prev().shiftId && data().employeeId == prev().employeeId;
      allow delete: if false;
    }

    // ======================================================== attendanceSessions
    // attendanceSessions/{shiftId}_{employeeId}
    match /attendanceSessions/{sessionId} {
      function validPunch(p) {
        return p is map
          && p.keys().hasOnly(['clientAt', 'serverAt', 'coords', 'accuracyMeters', 'distanceMeters',
                               'withinRadius', 'validation'])
          && p.clientAt is timestamp
          && p.serverAt == request.time
          && (p.coords == null || (p.coords is map && isLat(p.coords.lat) && isLng(p.coords.lng)))
          && isNumOrNull(p.accuracyMeters)
          && isNumOrNull(p.distanceMeters)
          && (p.withinRadius == null || p.withinRadius is bool)
          && p.validation == 'client';
      }
      function validIncidents() {
        return data().incidents is list && data().incidents.size() <= 50
          && data().hasIncident == (data().incidents.size() > 0);
      }
      function assignment() { return get(docPath('assignments', sessionId)).data; }
      function appendsIncidents() {
        return data().incidents.size() >= prev().incidents.size()
          && data().incidents.hasAll(prev().incidents);
      }
      function nextBreakPath() {
        return docPath('breakRecords', sessionId + '_' + string(prev().breakCount + 1));
      }
      function currentBreakPath() {
        return docPath('breakRecords', sessionId + '_' + string(prev().breakCount));
      }

      // get por id: el sufijo del id es el employeeId (permite comprobar si ya existe la jornada).
      allow get: if isAdmin()
        || (hasEmployee() && sessionId.split('_').size() == 2 && sessionId.split('_')[1] == myEmployeeId());
      allow list: if isAdmin() || (signedIn() && resource.data.userId == uid());

      // Entrada: solo para el propio trabajador, con asignación CONFIRMADA y en
      // una ventana razonable alrededor del turno (2 h antes – fin del turno).
      allow create: if hasEmployee()
        && data().keys().hasOnly(['shiftId', 'eventId', 'employeeId', 'userId', 'employeeName', 'eventName',
                                  'shiftName', 'shiftStartAt', 'shiftEndAt', 'status', 'checkIn', 'checkOut',
                                  'breakCount', 'totalBreakMinutes', 'workedMinutes', 'incidents',
                                  'hasIncident', 'adminNote', 'createdAt', 'updatedAt'])
        && data().userId == uid()
        && data().employeeId == myEmployeeId()
        && sessionId == data().shiftId + '_' + data().employeeId
        && assignment().status == 'confirmed'
        && data().eventId == assignment().eventId
        && data().employeeName == assignment().employeeName
        && data().eventName == assignment().eventName
        && data().shiftName == assignment().shiftName
        && data().shiftStartAt == assignment().shiftStartAt
        && data().shiftEndAt == assignment().shiftEndAt
        && request.time >= assignment().shiftStartAt - duration.value(120, 'm')
        && request.time <= assignment().shiftEndAt
        && data().status == 'open'
        && validPunch(data().checkIn)
        && data().checkOut == null
        && data().breakCount == 0
        && data().totalBreakMinutes == 0
        && data().workedMinutes == null
        && data().adminNote == ''
        && validIncidents()
        && createdNow();

      // Transiciones del propio trabajador. La entrada (checkIn) es inmutable.
      allow update: if signedIn() && prev().userId == uid()
        && prev().status != 'closed'
        && changedKeys().hasOnly(['status', 'checkOut', 'breakCount', 'totalBreakMinutes', 'workedMinutes',
                                  'incidents', 'hasIncident', 'updatedAt'])
        && validIncidents() && appendsIncidents() && updatedNow()
        && (
          // Inicio de pausa
          (prev().status == 'open' && data().status == 'on_break'
            && data().breakCount == prev().breakCount + 1
            && data().totalBreakMinutes == prev().totalBreakMinutes
            && data().checkOut == null && data().workedMinutes == null
            && existsAfter(nextBreakPath()))
          ||
          // Fin de pausa
          (prev().status == 'on_break' && data().status == 'open'
            && data().breakCount == prev().breakCount
            && data().totalBreakMinutes is int && data().totalBreakMinutes >= prev().totalBreakMinutes
            && data().checkOut == null && data().workedMinutes == null
            && getAfter(currentBreakPath()).data.end != null)
          ||
          // Salida
          (prev().status == 'open' && data().status == 'closed'
            && data().breakCount == prev().breakCount
            && data().totalBreakMinutes == prev().totalBreakMinutes
            && validPunch(data().checkOut)
            && data().workedMinutes is int && data().workedMinutes >= 0)
        );

      // Revisión administrativa: cerrar jornadas incompletas y anotar.
      // No puede alterar la entrada registrada por el trabajador.
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status', 'checkOut', 'workedMinutes', 'incidents', 'hasIncident',
                                  'adminNote', 'updatedAt'])
        && data().status in ['open', 'on_break', 'closed']
        && validIncidents() && appendsIncidents()
        && isStr(data().adminNote, 0, 1000)
        && updatedNow();

      allow delete: if false;
    }

    // ============================================================== breakRecords
    // breakRecords/{sessionId}_{index}
    match /breakRecords/{breakId} {
      function session() { return get(docPath('attendanceSessions', request.resource.data.sessionId)).data; }
      function validStart(p) {
        return p is map && p.clientAt is timestamp && p.serverAt == request.time
          && p.validation == 'client'
          && (p.coords == null || (p.coords is map && isLat(p.coords.lat) && isLng(p.coords.lng)));
      }

      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());

      allow create: if hasEmployee()
        && data().keys().hasOnly(['sessionId', 'employeeId', 'userId', 'index', 'start', 'end', 'durationMinutes'])
        && data().userId == uid()
        && data().employeeId == myEmployeeId()
        && data().index is int
        && breakId == data().sessionId + '_' + string(data().index)
        && session().userId == uid()
        && session().status == 'open'
        && data().index == session().breakCount + 1
        && validStart(data().start)
        && data().end == null && data().durationMinutes == null
        && getAfter(docPath('attendanceSessions', data().sessionId)).data.status == 'on_break';

      allow update: if signedIn() && prev().userId == uid()
        && prev().end == null
        && changedKeys().hasOnly(['end', 'durationMinutes'])
        && validStart(data().end)
        && data().durationMinutes is int && data().durationMinutes >= 0
        && getAfter(docPath('attendanceSessions', prev().sessionId)).data.status == 'open';

      // Cierre administrativo de una pausa que quedó abierta.
      allow update: if isAdmin()
        && prev().end == null
        && changedKeys().hasOnly(['end', 'durationMinutes'])
        && data().durationMinutes is int && data().durationMinutes >= 0
        && getAfter(docPath('attendanceSessions', prev().sessionId)).data.status == 'closed';

      allow delete: if false;
    }

    // ============================================================= notifications
    match /notifications/{notificationId} {
      function notificationKeys() {
        return ['type', 'title', 'body', 'link', 'recipientEmployeeId', 'recipientRole', 'read', 'readAt',
                'createdAt', 'createdBy'];
      }
      function validNotification() {
        return data().keys().hasOnly(notificationKeys()) && data().keys().hasAll(notificationKeys())
          && data().type in ['assignment_new', 'assignment_cancelled', 'schedule_changed', 'event_cancelled',
                             'event_reminder', 'availability_request', 'attendance_incident', 'general']
          && isStr(data().title, 1, 160)
          && isStr(data().body, 0, 2000)
          && isStrOrNull(data().link, 300)
          && ((data().recipientEmployeeId is string && data().recipientRole == null)
              || (data().recipientEmployeeId == null && data().recipientRole == 'admin'))
          && data().read == false && data().readAt == null
          && data().createdAt == request.time
          && data().createdBy == uid();
      }
      function isRecipient(n) {
        return (n.recipientRole == 'admin' && isAdmin())
          || (n.recipientEmployeeId != null && hasEmployee() && n.recipientEmployeeId == myEmployeeId());
      }

      allow read: if signedIn() && isRecipient(resource.data);

      allow create: if validNotification() && (
        isAdmin()
        || (isWorker() && data().type == 'attendance_incident' && data().recipientRole == 'admin')
      );

      // El destinatario solo puede marcarla como leída.
      allow update: if signedIn() && isRecipient(prev())
        && changedKeys().hasOnly(['read', 'readAt'])
        && data().read == true && data().readAt == request.time;

      allow delete: if signedIn() && isRecipient(resource.data);
    }

    // ================================================================= auditLogs
    // Registro de solo inserción. Nadie puede modificarlo ni borrarlo.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if hasProfile()
        && data().keys().hasOnly(['actorUid', 'action', 'entityType', 'entityId', 'summary', 'at'])
        && data().actorUid == uid()
        && data().at == request.time
        && isStr(data().action, 1, 60)
        && isStr(data().entityId, 1, 300)
        && isStr(data().summary, 0, 500)
        && (
          (isAdmin() && data().entityType in ['user', 'employee', 'invitation', 'location', 'event', 'shift',
                                              'assignment', 'attendance', 'availability', 'settings'])
          || data().entityType in ['attendance', 'availability', 'user']
        );
      allow update, delete: if false;
    }

    // ================================================================== settings
    match /settings/{settingId} {
      allow read: if hasProfile();
      allow write: if isAdmin() && settingId == 'company'
        && data().keys().hasOnly(['companyName', 'timezone', 'defaultRadiusMeters', 'maxAccuracyMeters',
                                  'checkInEarlyMinutes', 'updatedAt'])
        && isStr(data().companyName, 1, 120)
        && data().timezone == 'Europe/Madrid'
        && data().defaultRadiusMeters is number && data().defaultRadiusMeters >= 10 && data().defaultRadiusMeters <= 5000
        && data().maxAccuracyMeters is number && data().maxAccuracyMeters >= 5 && data().maxAccuracyMeters <= 2000
        && data().checkInEarlyMinutes is int && data().checkInEarlyMinutes >= 0 && data().checkInEarlyMinutes <= 120
        && updatedNow();
    }

    // Todo lo demás queda denegado por defecto (no existe regla comodín).
  }
}
